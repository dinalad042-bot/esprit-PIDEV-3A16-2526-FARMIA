{% extends 'layouts/expert.html.twig' %}

{% block title %}Demandes — FarmAI{% endblock %}

{% block body %}
<div style="padding:2rem;">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
        <div>
            <a href="{{ path('dashboard_expert') }}" style="color:#666; text-decoration:none; font-size:0.9rem;">
                <i class="fa-solid fa-arrow-left"></i> Retour au tableau de bord
            </a>
            <h2 style="font-size:1.5rem; font-weight:700; color:#1a1a2e; margin:0.5rem 0 0;">
                <i class="fa-solid fa-bell" style="color:#1e2a38;"></i>
                Gestion des Demandes
            </h2>
            <p style="color:#888; margin:0.25rem 0 0; font-size:0.9rem;">
                Consultez les demandes en attente et gérez vos analyses en cours
            </p>
        </div>
    </div>

    {# Section 1: In-Progress Requests (with Terminer button) #}
    {% set inProgressRequests = requests|filter(r => r.statut == 'en_cours' and r.technicien == app.user) %}
    {% if inProgressRequests|length > 0 %}
    <div style="margin-bottom: 2rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h3 style="font-size:1.2rem; font-weight:700; color:#1e2a38; margin:0;">
                <i class="fa-solid fa-spinner" style="color:#1e2a38;"></i>
                Mes demandes en cours ({{ inProgressRequests|length }})
            </h3>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(400px,1fr)); gap:1.5rem;">
            {% for request in inProgressRequests %}
            <div style="background:#fff; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); overflow:hidden; border-left:4px solid #1e2a38;">
                <div style="background:linear-gradient(135deg,#eceff1,#cfd8dc); padding:1rem; display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-weight:700; color:#1e2a38; font-size:0.9rem;">
                        <i class="fa-solid fa-spinner"></i> En cours
                    </span>
                    <span style="color:#888; font-size:0.8rem;">#{{ request.id }}</span>
                </div>
                <div style="padding:1.25rem;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:1rem; padding-bottom:1rem; border-bottom:1px solid #f0f0f0;">
                        <div>
                            <div style="color:#888; font-size:0.8rem;">Date</div>
                            <div style="color:#333; font-weight:500;">{{ request.dateAnalyse ? request.dateAnalyse|date('d/m/Y H:i') : 'N/A' }}</div>
                        </div>
                        <div>
                            <div style="color:#888; font-size:0.8rem;">Ferme</div>
                            <div style="color:#333; font-weight:500;">{{ request.ferme ? request.ferme.nomFerme : 'N/A' }}</div>
                        </div>
                    </div>
                    {% if request.descriptionDemande %}
                    <div style="margin-bottom:1rem;">
                        <div style="color:#888; font-size:0.8rem; margin-bottom:0.25rem;">Description</div>
                        <p style="color:#555; font-size:0.85rem; line-height:1.5; margin:0; background:#f8f9fa; padding:0.75rem; border-radius:6px;">
                            {{ request.descriptionDemande|slice(0, 150) }}{% if request.descriptionDemande|length > 150 %}...{% endif %}
                        </p>
                    </div>
                    {% endif %}
                    {% if request.imageUrl %}
                    <div style="margin-bottom:1rem;">
                        <img src="{{ request.imageUrl }}" alt="Image" style="width:100%; height:100px; object-fit:cover; border-radius:6px;" onerror="this.style.display='none';">
                    </div>
                    {% endif %}
                    <div style="display:flex; gap:0.75rem;">
                        <a href="{{ path('expert_analyse_show', {id: request.id}) }}" style="flex:1; display:inline-block; text-align:center; background:#455A64; color:#fff; border:none; padding:10px; border-radius:8px; font-size:0.9rem; text-decoration:none;">
                            <i class="fa-solid fa-eye"></i> Voir
                        </a>
                        {% if request.imageUrl %}
                        <a href="{{ path('expert_analyse_diagnose', {id: request.id}) }}" style="flex:1; display:inline-block; text-align:center; background:#9C27B0; color:#fff; border:none; padding:10px; border-radius:8px; font-size:0.9rem; text-decoration:none;">
                            <i class="fa-solid fa-robot"></i> IA
                        </a>
                        {% endif %}
                        <button onclick="showTerminerModal({{ request.id }}, '{{ request.id }}')" style="flex:1; background:#1e2a38; color:#fff; border:none; padding:10px; border-radius:8px; font-size:0.9rem; cursor:pointer;">
                            <i class="fa-solid fa-check"></i> Terminer
                        </button>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Section 2: Pending Requests (from farmers) #}
    {% set pendingRequests = requests|filter(r => r.statut == 'en_attente') %}
    <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h3 style="font-size:1.2rem; font-weight:700; color:#1a1a2e; margin:0;">
                <i class="fa-solid fa-bell" style="color:#e74c3c;"></i>
                Demandes en attente ({{ pendingRequests|length }})
            </h3>
        </div>

        {% if pendingRequests|length == 0 %}
        <div style="text-align:center; padding:4rem; background:#fff; border-radius:12px; color:#aaa;">
            <i class="fa-solid fa-check-circle" style="font-size:4rem; margin-bottom:1rem; display:block; color:#2ecc71;"></i>
            <p style="font-size:1.2rem; color:#666;">Aucune demande en attente</p>
            <p style="font-size:0.9rem; color:#888; margin-top:0.5rem;">Toutes les demandes ont été prises en charge</p>
        </div>
        {% else %}
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(350px,1fr)); gap:1.5rem;">
            {% for request in pendingRequests %}
            <div style="background:#fff; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); overflow:hidden; border-left:4px solid #e74c3c;">
                <div style="background:linear-gradient(135deg,#ffebee,#ffcdd2); padding:1rem; display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-weight:700; color:#c62828; font-size:0.9rem;">
                        <i class="fa-solid fa-clock"></i> En attente
                    </span>
                    <span style="color:#888; font-size:0.8rem;">
                        {{ request.dateAnalyse ? request.dateAnalyse|date('d/m/Y H:i') : 'N/A' }}
                    </span>
                </div>

                <div style="padding:1.25rem;">
                    {% if request.demandeur %}
                    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem; padding-bottom:1rem; border-bottom:1px solid #f0f0f0;">
                        <div style="width:40px; height:40px; background:linear-gradient(135deg,#2ecc71,#27ae60); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-weight:600;">
                            {{ request.demandeur.prenom|first }}{{ request.demandeur.nom|first }}
                        </div>
                        <div>
                            <div style="font-weight:600; color:#333;">{{ request.demandeur.prenom }} {{ request.demandeur.nom }}</div>
                            <div style="font-size:0.8rem; color:#888;">{{ request.demandeur.email }}</div>
                        </div>
                    </div>
                    {% endif %}

                    {% if request.ferme %}
                    <div style="margin-bottom:0.75rem;">
                        <div style="color:#888; font-size:0.8rem; margin-bottom:0.25rem;">Ferme</div>
                        <div style="color:#333; font-weight:500;">
                            <i class="fa-solid fa-map-marker-alt" style="color:#1e2a38; margin-right:4px;"></i>
                            {{ request.ferme.nomFerme }}
                        </div>
                    </div>
                    {% endif %}

                    {% if request.animalCible %}
                    <div style="margin-bottom:0.75rem;">
                        <div style="color:#888; font-size:0.8rem; margin-bottom:0.25rem;">Animal</div>
                        <div style="color:#333; font-weight:500;">
                            <i class="fa-solid fa-paw" style="color:#1e2a38; margin-right:4px;"></i>
                            {{ request.animalCible.espece }}
                        </div>
                    </div>
                    {% endif %}

                    {% if request.planteCible %}
                    <div style="margin-bottom:0.75rem;">
                        <div style="color:#888; font-size:0.8rem; margin-bottom:0.25rem;">Plante</div>
                        <div style="color:#333; font-weight:500;">
                            <i class="fa-solid fa-seedling" style="color:#1e2a38; margin-right:4px;"></i>
                            {{ request.planteCible.nomEspece }}
                        </div>
                    </div>
                    {% endif %}

                    {% if request.descriptionDemande %}
                    <div style="margin-bottom:1rem;">
                        <div style="color:#888; font-size:0.8rem; margin-bottom:0.25rem;">Description</div>
                        <p style="color:#555; font-size:0.85rem; line-height:1.5; margin:0; background:#f8f9fa; padding:0.75rem; border-radius:6px;">
                            {{ request.descriptionDemande|slice(0, 150) }}{% if request.descriptionDemande|length > 150 %}...{% endif %}
                        </p>
                    </div>
                    {% endif %}

                    {% if request.imageUrl %}
                    <div style="margin-bottom:1rem;">
                        <img src="{{ request.imageUrl }}" alt="Image" style="width:100%; height:120px; object-fit:cover; border-radius:6px;" onerror="this.style.display='none';">
                    </div>
                    {% endif %}

                    <form method="POST" action="{{ path('expert_take_request', {id: request.id}) }}">
                        <button type="submit"
                                style="width:100%; background:#1e2a38; color:#fff; border:none; padding:12px; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer;">
                            <i class="fa-solid fa-hand-holding-medical"></i> Prendre en charge
                        </button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# Terminer Modal #}
<div id="terminerModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); background:#fff; padding:2rem; border-radius:12px; width:500px; max-width:90%;">
        <h3 style="margin-top:0; color:#1e2a38; font-size:1.3rem;">
            <i class="fa-solid fa-check-circle"></i> Terminer l'Analyse
        </h3>
        <p style="color:#666; margin-bottom:1rem;">Entrez le résultat technique pour finaliser cette analyse:</p>

        <form id="terminerForm" method="POST" action="{{ path('expert_complete_request', {id: 0})|replace({'/0': ''}) }}">
            <textarea name="resultat_technique" rows="8"
                      style="width:100%; padding:12px; border:1px solid #ddd; border-radius:8px; font-size:0.95rem; resize:vertical;"
                      placeholder="Décrivez le diagnostic, les symptômes observés, le traitement recommandé, et les conseils pour l'agriculteur..."
                      required></textarea>

            <div style="display:flex; gap:1rem; margin-top:1rem;">
                <button type="button" onclick="closeTerminerModal()"
                        style="flex:1; padding:12px; background:#e0e0e0; color:#333; border:none; border-radius:8px; cursor:pointer; font-size:0.95rem;">
                    Annuler
                </button>
                <button type="submit"
                        style="flex:1; padding:12px; background:#1e2a38; color:#fff; border:none; border-radius:8px; cursor:pointer; font-size:0.95rem; font-weight:600;">
                    <i class="fa-solid fa-save"></i> Sauvegarder
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function showTerminerModal(analyseId, displayId) {
    var form = document.getElementById('terminerForm');
    form.action = '/expert/demande/' + analyseId + '/terminer';
    document.getElementById('terminerModal').style.display = 'block';
}

function closeTerminerModal() {
    document.getElementById('terminerModal').style.display = 'none';
}

document.getElementById('terminerModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeTerminerModal();
    }
});
</script>
{% endblock %}