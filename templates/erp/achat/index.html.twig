{% extends 'erp/layout.html.twig' %}
{% block title %}Achats — FarmIA Desk{% endblock %}

{% block stylesheets %}
<style>
:root { --stripe: #635bff; --green: #22c55e; --dark: #0f172a; --card-bg: #fff; }

.page-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 2rem;
}
.page-header h1 { font-size: 1.5rem; font-weight: 700; color: var(--dark); margin: 0; }

.stats-bar {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem;
}
.stat-box {
    background: #fff; border-radius: 14px; padding: 1.2rem 1.5rem;
    box-shadow: 0 1px 6px rgba(0,0,0,.07); display: flex; align-items: center; gap: 1rem;
}
.stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.stat-icon.green { background: #dcfce7; color: #16a34a; }
.stat-icon.purple { background: #ede9fe; color: #7c3aed; }
.stat-icon.blue { background: #dbeafe; color: #2563eb; }
.stat-label { font-size: .75rem; color: #94a3b8; font-weight: 500; }
.stat-value { font-size: 1.3rem; font-weight: 700; color: var(--dark); }

.orders-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;
}
.order-card {
    background: var(--card-bg); border-radius: 16px; overflow: hidden;
    box-shadow: 0 2px 10px rgba(0,0,0,.07); transition: transform .15s, box-shadow .15s;
    display: flex; flex-direction: column; border: 1px solid #f1f5f9;
}
.order-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.12); }

.card-banner {
    height: 8px;
    background: linear-gradient(90deg, var(--green), #16a34a);
}
.card-banner.paid { background: linear-gradient(90deg, #635bff, #818cf8); }

.card-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: .75rem; }

.card-meta { display: flex; align-items: center; justify-content: space-between; }
.card-id { font-size: .7rem; font-weight: 700; color: #94a3b8; letter-spacing: .05em; text-transform: uppercase; }
.card-date { font-size: .78rem; color: #64748b; display: flex; align-items: center; gap: .3rem; }

.badge-paid {
    display: inline-flex; align-items: center; gap: .35rem;
    background: #ede9fe; color: #7c3aed; font-size: .72rem; font-weight: 600;
    padding: .25rem .65rem; border-radius: 20px;
}
.badge-pending {
    display: inline-flex; align-items: center; gap: .35rem;
    background: #fef9c3; color: #a16207; font-size: .72rem; font-weight: 600;
    padding: .25rem .65rem; border-radius: 20px;
}

.card-lines { flex: 1; }
.card-line {
    display: flex; justify-content: space-between; align-items: center;
    font-size: .8rem; color: #475569; padding: .3rem 0;
    border-bottom: 1px dashed #f1f5f9;
}
.card-line:last-child { border-bottom: none; }
.card-line-name { display: flex; align-items: center; gap: .4rem; }
.card-line-name i { color: var(--green); font-size: .65rem; }

.card-total {
    display: flex; align-items: center; justify-content: space-between;
    background: #f8fafc; border-radius: 10px; padding: .6rem .9rem; margin-top: .25rem;
}
.card-total-label { font-size: .78rem; color: #64748b; }
.card-total-value { font-size: 1.15rem; font-weight: 700; color: var(--green); }

.card-footer {
    padding: .9rem 1.25rem; border-top: 1px solid #f1f5f9;
    display: flex; gap: .5rem; align-items: center;
}

.btn-pay {
    flex: 1; background: var(--stripe); color: #fff; border: none;
    border-radius: 10px; padding: .55rem 1rem; font-weight: 600; font-size: .85rem;
    cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
    transition: background .15s, transform .1s;
}
.btn-pay:hover { background: #4f46e5; transform: translateY(-1px); }

.btn-delete {
    background: #fee2e2; color: #dc2626; border: none; border-radius: 10px;
    padding: .55rem .75rem; cursor: pointer; font-size: .85rem; transition: background .15s;
}
.btn-delete:hover { background: #fecaca; }

.empty-state {
    text-align: center; padding: 5rem 2rem; color: #94a3b8;
    background: #fff; border-radius: 16px; border: 2px dashed #e2e8f0;
}
.empty-state i { font-size: 3.5rem; margin-bottom: 1rem; display: block; color: #cbd5e1; }
.empty-state h3 { color: #475569; margin: 0 0 .5rem; }

/* Modal */
.modal-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(15,23,42,.6); z-index: 2000;
    align-items: center; justify-content: center; backdrop-filter: blur(4px);
}
.modal-overlay.open { display: flex; }
.modal {
    background: #fff; border-radius: 20px; padding: 2rem; width: 440px; max-width: 95vw;
    box-shadow: 0 25px 60px rgba(0,0,0,.25); position: relative;
    animation: popIn .2s cubic-bezier(.34,1.56,.64,1);
}
@keyframes popIn { from{transform:scale(.9);opacity:0} to{transform:scale(1);opacity:1} }
.modal-close {
    position: absolute; top: 1rem; right: 1rem; background: #f1f5f9; border: none;
    border-radius: 8px; width: 32px; height: 32px; cursor: pointer; color: #64748b;
    display: flex; align-items: center; justify-content: center;
}
.modal-close:hover { background: #e2e8f0; }
.modal-icon { text-align: center; font-size: 3rem; margin-bottom: .75rem; }
.modal-title { text-align: center; font-size: 1.15rem; font-weight: 700; color: var(--dark); margin: 0 0 .25rem; }
.modal-sub { text-align: center; font-size: .82rem; color: #94a3b8; margin: 0 0 1.25rem; }
.modal-amount {
    background: linear-gradient(135deg, #635bff15, #22c55e15);
    border: 1px solid #e2e8f0; border-radius: 12px; padding: 1rem;
    text-align: center; margin-bottom: 1.5rem;
}
.modal-amount-label { font-size: .75rem; color: #94a3b8; margin-bottom: .25rem; }
.modal-amount-value { font-size: 2rem; font-weight: 800; color: var(--dark); }
.modal-actions { display: flex; gap: .75rem; }
.modal-actions button { flex: 1; padding: .7rem; border-radius: 10px; font-weight: 600; font-size: .9rem; cursor: pointer; border: none; display: inline-flex; align-items: center; justify-content: center; gap: .4rem; transition: all .15s; }
.btn-modal-cancel { background: #f1f5f9; color: #475569; }
.btn-modal-cancel:hover { background: #e2e8f0; }
.btn-modal-confirm { background: var(--stripe); color: #fff; }
.btn-modal-confirm:hover { background: #4f46e5; }
.btn-modal-confirm:disabled { opacity: .6; cursor: not-allowed; }
.spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="fa-solid fa-cart-plus" style="color:var(--green);"></i> Achats de matières</h1>
    <a href="{{ path('erp_achat_new') }}" class="btn-erp btn-primary">
        <i class="fa-solid fa-plus"></i> Nouvel achat
    </a>
</div>

{% set totalAll = 0 %}
{% set paidCount = 0 %}
{% for a in achats %}
    {% set totalAll = totalAll + a.total %}
    {% if a.paid %}{% set paidCount = paidCount + 1 %}{% endif %}
{% endfor %}

<div class="stats-bar">
    <div class="stat-box">
        <div class="stat-icon green"><i class="fa-solid fa-cart-shopping"></i></div>
        <div>
            <div class="stat-label">Total achats</div>
            <div class="stat-value">{{ achats|length }}</div>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon purple"><i class="fa-solid fa-circle-check"></i></div>
        <div>
            <div class="stat-label">Payés</div>
            <div class="stat-value">{{ paidCount }}</div>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon blue"><i class="fa-solid fa-coins"></i></div>
        <div>
            <div class="stat-label">Montant total</div>
            <div class="stat-value">{{ totalAll|number_format(2,',',' ') }} €</div>
        </div>
    </div>
</div>

{% if achats|length == 0 %}
<div class="empty-state">
    <i class="fa-solid fa-cart-plus"></i>
    <h3>Aucun achat enregistré</h3>
    <p>Commencez par créer votre premier achat de matières.</p>
    <a href="{{ path('erp_achat_new') }}" class="btn-erp btn-primary" style="margin-top:1rem;">
        <i class="fa-solid fa-plus"></i> Créer un achat
    </a>
</div>
{% else %}
<div class="orders-grid">
    {% for a in achats %}
    <div class="order-card">
        <div class="card-banner {{ a.paid ? 'paid' : '' }}"></div>
        <div class="card-body">
            <div class="card-meta">
                <span class="card-id">Achat #{{ a.idAchat }}</span>
                {% if a.paid %}
                    <span class="badge-paid"><i class="fa-solid fa-circle-check"></i> Payé</span>
                {% else %}
                    <span class="badge-pending"><i class="fa-solid fa-clock"></i> En attente</span>
                {% endif %}
            </div>
            <div class="card-date">
                <i class="fa-regular fa-calendar"></i> {{ a.dateAchat|date('d/m/Y') }}
            </div>
            <div class="card-lines">
                {% for l in a.lignes %}
                <div class="card-line">
                    <span class="card-line-name">
                        <i class="fa-solid fa-circle-dot"></i>
                        {{ l.matiere.nom }} — {{ l.quantite }} {{ l.matiere.unite }}
                    </span>
                    <strong>{{ l.sousTotal|number_format(2,',',' ') }} €</strong>
                </div>
                {% endfor %}
            </div>
            <div class="card-total">
                <span class="card-total-label"><i class="fa-solid fa-sigma"></i> Total</span>
                <span class="card-total-value">{{ a.total|number_format(2,',',' ') }} €</span>
            </div>
        </div>
        <div class="card-footer">
            {% if not a.paid %}
            <button type="button" class="btn-pay open-pay-modal"
                    data-id="{{ a.idAchat }}"
                    data-total="{{ a.total|number_format(2,',',' ') }}"
                    data-token="{{ csrf_token('pay_achat_' ~ a.idAchat) }}"
                    data-pay-url="{{ path('erp_achat_pay', {id: a.idAchat}) }}">
                <i class="fa-brands fa-stripe"></i> Payer avec Stripe
            </button>
            {% else %}
            <span style="flex:1;font-size:.8rem;color:#7c3aed;font-weight:600;">
                <i class="fa-solid fa-lock"></i> Paiement complété
            </span>
            {% endif %}
            <form method="post" action="{{ path('erp_achat_delete', {id: a.idAchat}) }}"
                  onsubmit="return confirm('Supprimer cet achat ? Le stock sera restauré.')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_achat_' ~ a.idAchat) }}">
                <button type="submit" class="btn-delete" title="Supprimer">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

{# Hidden pay forms #}
{% for a in achats %}
{% if not a.paid %}
<form id="pay-form-{{ a.idAchat }}" method="post" action="{{ path('erp_achat_pay', {id: a.idAchat}) }}" style="display:none;">
    <input type="hidden" name="_token" value="{{ csrf_token('pay_achat_' ~ a.idAchat) }}">
</form>
{% endif %}
{% endfor %}

{# Confirm Modal #}
<div class="modal-overlay" id="confirmModal">
    <div class="modal">
        <button class="modal-close" id="closeConfirm"><i class="fa-solid fa-xmark"></i></button>
        <div class="modal-icon">💳</div>
        <div class="modal-title">Confirmer le paiement</div>
        <div class="modal-sub">Vous serez redirigé vers la page de paiement sécurisée Stripe</div>
        <div class="modal-amount">
            <div class="modal-amount-label">Montant à payer</div>
            <div class="modal-amount-value" id="modalTotal">—</div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel" id="cancelPay">Annuler</button>
            <button type="button" class="btn-modal-confirm" id="confirmPay">
                <i class="fa-brands fa-stripe"></i> Payer maintenant
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    let currentFormId = '';
    const modal = document.getElementById('confirmModal');
    const modalTotal = document.getElementById('modalTotal');
    const confirmBtn = document.getElementById('confirmPay');

    const open = () => modal.classList.add('open');
    const close = () => modal.classList.remove('open');

    document.querySelectorAll('.open-pay-modal').forEach(btn => {
        btn.addEventListener('click', function () {
            currentFormId = 'pay-form-' + this.dataset.id;
            modalTotal.textContent = this.dataset.total + ' €';
            open();
        });
    });

    document.getElementById('closeConfirm').addEventListener('click', close);
    document.getElementById('cancelPay').addEventListener('click', close);
    modal.addEventListener('click', e => { if (e.target === modal) close(); });

    confirmBtn.addEventListener('click', function () {
        this.disabled = true;
        this.innerHTML = '<span class="spinner"></span> Redirection vers Stripe…';
        document.getElementById(currentFormId).submit();
    });
})();
</script>
{% endblock %}
