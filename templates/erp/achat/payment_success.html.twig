{% extends 'erp/layout.html.twig' %}
{% block title %}Paiement confirmé — FarmIA Desk{% endblock %}

{% block stylesheets %}
<style>
.success-wrapper {
    display: flex; align-items: center; justify-content: center;
    min-height: 70vh; padding: 2rem;
}
.success-card {
    background: #fff; border-radius: 24px; padding: 3rem 2.5rem;
    max-width: 520px; width: 100%; text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,.1);
    animation: popIn .4s cubic-bezier(.34,1.56,.64,1);
}
@keyframes popIn { from{transform:scale(.9);opacity:0} to{transform:scale(1);opacity:1} }

.success-icon {
    width: 80px; height: 80px; background: #dcfce7; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem; margin: 0 auto 1.5rem;
    box-shadow: 0 0 0 12px #f0fdf4;
}
.success-title { font-size: 1.5rem; font-weight: 800; color: #15803d; margin: 0 0 .5rem; }
.success-sub { font-size: .9rem; color: #64748b; margin: 0 0 2rem; }

.receipt {
    background: #f8fafc; border-radius: 14px; padding: 1.25rem;
    margin-bottom: 2rem; text-align: left;
}
.receipt-header {
    display: flex; align-items: center; gap: .5rem;
    font-size: .8rem; font-weight: 700; color: #475569;
    text-transform: uppercase; letter-spacing: .05em;
    margin-bottom: 1rem; padding-bottom: .75rem;
    border-bottom: 1px solid #e2e8f0;
}
.receipt-row {
    display: flex; justify-content: space-between; align-items: center;
    font-size: .85rem; color: #475569; padding: .35rem 0;
}
.receipt-row:not(:last-child) { border-bottom: 1px dashed #e2e8f0; }
.receipt-total {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: .75rem; padding-top: .75rem; border-top: 2px solid #e2e8f0;
    font-weight: 700; font-size: 1rem; color: #0f172a;
}
.receipt-total span:last-child { color: #16a34a; font-size: 1.15rem; }

.success-actions { display: flex; gap: .75rem; justify-content: center; }
.success-actions a {
    padding: .65rem 1.25rem; border-radius: 10px; font-weight: 600;
    font-size: .875rem; text-decoration: none; display: inline-flex;
    align-items: center; gap: .4rem; transition: all .15s;
}
.btn-primary-green { background: #16a34a; color: #fff; }
.btn-primary-green:hover { background: #15803d; }
.btn-outline { background: #f1f5f9; color: #475569; }
.btn-outline:hover { background: #e2e8f0; }

.confetti { font-size: 1.5rem; margin-bottom: .5rem; }
</style>
{% endblock %}

{% block body %}
<div class="success-wrapper">
    <div class="success-card">
        <div class="confetti">🎉</div>
        <div class="success-icon">✅</div>
        <div class="success-title">Paiement confirmé !</div>
        <div class="success-sub">
            Votre achat <strong>#{{ achat.idAchat }}</strong> du
            <strong>{{ achat.dateAchat|date('d/m/Y') }}</strong> a été réglé avec succès.
        </div>

        <div class="receipt">
            <div class="receipt-header">
                <i class="fa-solid fa-receipt" style="color:#22c55e;"></i> Récapitulatif de commande
            </div>
            {% for l in achat.lignes %}
            <div class="receipt-row">
                <span>{{ l.matiere.nom }} <span style="color:#94a3b8;">× {{ l.quantite }} {{ l.matiere.unite }}</span></span>
                <strong>{{ l.sousTotal|number_format(2,',',' ') }} €</strong>
            </div>
            {% endfor %}
            <div class="receipt-total">
                <span>Total payé</span>
                <span>{{ achat.total|number_format(2,',',' ') }} €</span>
            </div>
        </div>

        <div class="success-actions">
            <a href="{{ path('erp_achat_index') }}" class="btn-primary-green">
                <i class="fa-solid fa-list"></i> Mes achats
            </a>
            <a href="{{ path('erp_achat_new') }}" class="btn-outline">
                <i class="fa-solid fa-plus"></i> Nouvel achat
            </a>
        </div>
    </div>
</div>
{% endblock %}
